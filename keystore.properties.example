# ─── CampusGig Keystore & Environment Configuration Template ──────────────────
# Copy this file to 'keystore.properties' and fill in your values.
# DO NOT commit keystore.properties to Git.

# ─── Keystore Signing ────────────────────────────────────────────────────────
storeFile=campusgig.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=campusgig
keyPassword=YOUR_KEY_PASSWORD

# ─── API Endpoints ───────────────────────────────────────────────────────────
# Option 1: Standalone Emulator (Default)
BASE_URL="http://10.0.2.2:5000/api/"
SOCKET_URL="http://10.0.2.2:5000"

# Option 2: ADB Reverse / Localhost
# BASE_URL="http://localhost:5000/api/"
# SOCKET_URL="http://localhost:5000"

# Option 3: Physical Device over LAN Wi-Fi (Replace with your computer's LAN IP)
# BASE_URL="http://192.168.1.100:5000/api/"
# SOCKET_URL="http://192.168.1.100:5000"

# Option 4: Production Server
# BASE_URL="https://api.campusgig.com/api/"
# SOCKET_URL="https://api.campusgig.com"
