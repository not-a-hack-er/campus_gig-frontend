<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for Android 12+ (API 31+).
  See https://developer.android.com/about/versions/12/backup-restore#xml-changes

  SECURITY: We explicitly exclude the session SharedPreferences (campus_gig_prefs)
  from both cloud and device-transfer backups. This prevents JWT auth tokens and
  user credentials from being extracted via ADB backup or restored to other devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude auth session prefs — tokens must NOT be cloud-backed up -->
        <exclude domain="sharedpref" path="campus_gig_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude auth session prefs — new devices must log in fresh -->
        <exclude domain="sharedpref" path="campus_gig_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>